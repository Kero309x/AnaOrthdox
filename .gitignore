# Ana Orthodox — .gitignore
# Generated: 2026-11-17

# ===== Node.js =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm

# ===== Next.js =====
apps/web/.next/
apps/web/out/
apps/web/.vercel

# ===== NestJS / Build =====
apps/api/dist/
apps/api/.env
apps/api/.env.local
apps/api/.env.development.local
apps/api/.env.test.local
apps/api/.env.production.local

# ===== Environment Variables — NEVER COMMIT SECRETS =====
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ===== Prisma =====
# Schema is committed; migrations are committed
# Local database files are not committed
*.db
*.sqlite

# ===== Turborepo =====
.turbo/

# ===== Testing =====
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ===== Build Artifacts =====
dist/
build/
.cache/
*.tsbuildinfo

# ===== IDE & OS =====
.idea/
.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini

# ===== Logs =====
logs/
*.log

# ===== Package Manager Locks =====
# Tracking pnpm-lock.yaml for reproducible CI builds
package-lock.json
yarn.lock

# ===== Temporary =====
tmp/
temp/
*.tmp
*.temp

# ===== Security =====
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets/
credentials/
