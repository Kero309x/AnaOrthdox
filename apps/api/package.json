{
  "name": "@ana-orthodox/api",
  "version": "0.1.0",
  "private": true,
  "description": "Ana Orthodox \u2014 NestJS Modular Monolith API",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "node ../../scripts/run-node-tests.mjs dist",
    "test:unit": "node ../../scripts/run-node-tests.mjs dist",
    "test:integration": "node ../../scripts/run-node-tests.mjs dist",
    "prebuild": "prisma generate",
    "test:database": "node ../../scripts/integration/database-smoke.mjs",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@ana-orthodox/coptic-calendar": "workspace:*",
    "@ana-orthodox/shared-types": "workspace:*",
    "@ana-orthodox/validation": "workspace:*",
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@ana-orthodox/config": "workspace:*",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^12.5.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "prisma": "~7.10.1",
    "typescript": "^5.8.3",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.73.0"
  }
}
