{
  "name": "@ana-orthodox/web",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "type-check": "tsc --noEmit",
    "lint": "eslint src tests playwright.config.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm --workspace-root exec turbo run build lint type-check test --filter=@ana-orthodox/web...",
    "prebuild": "pnpm --filter @ana-orthodox/coptic-calendar build"
  },
  "dependencies": {
    "@ana-orthodox/api-client": "workspace:*",
    "@ana-orthodox/coptic-calendar": "workspace:*",
    "@ana-orthodox/design-tokens": "workspace:*",
    "@ana-orthodox/shared-types": "workspace:*",
    "@ana-orthodox/ui": "workspace:*",
    "@m3e/web": "^2.13.0",
    "@material/web": "^2.5.0",
    "@materialwebunofficial/md3e-web": "^1.0.14",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@material/material-color-utilities": "^0.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "@playwright/test": "^1.56.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Primary Arabic RTL web app with tested v9 frontend foundations. Backend connection is not enabled."
}
