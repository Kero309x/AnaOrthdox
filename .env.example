# Ana Orthodox — Environment Variables Template
# Copy this file to .env.local (development) and configure all values.
# NEVER commit a file containing real secrets.
# Generated: 2026-11-17

# ===== DATABASE =====
# PostgreSQL 16 connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ana_orthodox_dev?schema=public"

# ===== JWT AUTHENTICATION =====
# Access token secret (minimum 64 characters, random)
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_64_CHAR_SECRET"
# Access token expiry
JWT_ACCESS_EXPIRY="15m"
# Refresh token secret (different from access secret)
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_SECRET"
# Refresh token expiry
JWT_REFRESH_EXPIRY="7d"

# ===== APPLICATION =====
# API server port
API_PORT=3001
# Web app port (Next.js dev)
WEB_PORT=3000
# Node environment
NODE_ENV=development
# API base URL (used by Next.js to call the API)
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Web app base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== CORS =====
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS="http://localhost:3000"

# ===== RATE LIMITING =====
# Requests per minute for anonymous users
THROTTLE_ANONYMOUS_LIMIT=100
# Requests per minute for authenticated users
THROTTLE_AUTH_LIMIT=500
# Time-to-live for rate limit window (milliseconds)
THROTTLE_TTL=60000

# ===== FILE STORAGE (Future) =====
# For hymn audio files and other media
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
