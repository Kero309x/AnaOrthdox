# Development template only. Never commit real credentials.
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://ana_orthodox:ana_orthodox_secret@localhost:5432/ana_orthodox_dev?schema=public
# Development may use the explicit development fallback. Production requires
# a non-placeholder JWT_SECRET of at least 32 characters from your secret manager.
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production backend will refuse missing database/secret and non-HTTPS origins.
# COOKIE_SECURE is automatically true in production. Cookie SameSite remains strict.
